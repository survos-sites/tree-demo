{% extends 'layout.html.twig' %}

{% block title %}Topics (API Tree){% endblock %}

{% block body %}
    <h1>Topics (API Tree)</h1>

    <div class="row g-3">
        <div class="col-md-5">
            {% component api_tree with {
                class: topicClass,
                filter: filter|default({}),
                editable: true,
                caller: _self,
                selectedId: app.request.query.get('selectedId')
            } %}
                <twig:block name="api_tree_content">
                    <h5>{{ item.name ?? node.name }}</h5>
                    <p>{{ item.description ?? node.description }}</p>
                    <p class="text-muted">Right-click a node to add, rename, or delete it.</p>
                </twig:block>
            {% endcomponent %}
        </div>

    {#        <div class="col-md-7">#}
    {#            <div {{ stimulus_controller('topic') }}>#}
    {#                <h3 {{ stimulus_target('topic', 'title') }}>Selection</h3>#}
    {#                <pre class="border rounded p-3 bg-white" {{ stimulus_target('topic', 'results') }}>Select a topic node.</pre>#}
    {#            </div>#}
    {#        </div>#}
    </div>
{% endblock %}
