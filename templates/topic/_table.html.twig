

<table class="table js-datatable">
    <thead>
    <tr>
        <th>actions</th>
                    <th>Code</th>
                    <th>Name</th>
                    <th>Description</th>
                    <th>Child Count</th>
                    <th>Lvl</th>
            </tr>
    </thead>
    <tbody>
    {% for topic in topics %}
    <tr>
        <td>
            <a href="{{ path('topic_show', {topicId: topic.code}) }}">
                {{ ux_icon('tabler:eye') }}
                {{ ux_icon('tabler:info-circle') }}
            </a>
            <a href="{{ path('topic_edit', {topicId: topic.code}) }}">
                {{ ux_icon('tabler:pencil') }}
                {{ ux_icon('tabler:pencil') }}
            </a>
        </td>

                    <td>{{ topic.code }}</td>
                    <td>{{ topic.name }}</td>
                    <td>{{ topic.description }}</td>
                    <td>{{ topic.childCount }}</td>
                    <td>{{ topic.level }}</td>
            </tr>
    {% else %}
    <tr>
        <td colspan="7">no records found</td>
    </tr>
    {% endfor %}
    </tbody>
</table>
