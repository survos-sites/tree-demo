{% extends '@SurvosTabler/layout/base.html.twig' %}

{% block title %}Tree & Table Playground{% endblock %}
{% block page_header %}{% endblock %}
{% block stylesheets %}
    <link rel="icon" type="image/svg+xml" href="{{ path('survos_tabler_favicon') }}">
{% endblock %}
{% block javascripts %}{{ importmap('app') }}{% endblock %}
{% block footer %}
    <footer class="footer footer-transparent d-print-none">
        <div class="container-xl text-secondary">
            {% if app.user %}
                {{ app.user.userIdentifier }} · <a href="{{ path('app_inventory') }}">My inventory</a> · <a href="{{ logout_path() }}">Sign out</a> ·
            {% else %}
                <a href="{{ path('app_login') }}">Sign in</a> · <a href="{{ path('app_register') }}">Register</a> ·
            {% endif %}
            Tree & Table Playground · <a href="https://cv.iptc.org/newscodes/mediatopic/">IPTC Media Topics</a>
        </div>
    </footer>
{% endblock %}
