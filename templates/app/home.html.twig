{% extends 'base.html.twig' %}
{% block title %}Tree & Table Playground{% endblock %}
{% block body %}
    <div class="mb-4">
        <div class="page-pretitle">Symfony UX · IPTC Media Topics</div>
        <h1 class="mb-2">One dataset, a few ways to explore it.</h1>
        <p class="text-secondary">Browse {{ topicCount|number_format }} topics. Compare table backends, explore the hierarchy, and try the existing API grid.</p>
    </div>
    <div class="row row-cards">
        {% for item in [
            {route: 'topics_playground', title: 'Table playground', icon: 'tabler:table', text: 'Compare UX DataTables, Simple DataTables, and plain HTML with the same Twig-rendered cells.'},
            {route: 'app_tree_html', title: 'Topic tree', icon: 'tabler:hierarchy', text: 'Explore the topic hierarchy, expand branches, and search the tree.'},
            {route: 'topic_index', title: 'API grid', icon: 'tabler:layout-grid', text: 'Browse the existing API Platform grid with server-side pagination and filtering.'}
        ] %}
            <div class="col-md-4">
                <div class="card h-100"><div class="card-body">
                    <div class="text-primary mb-3">{{ ux_icon(item.icon, {width: 28, height: 28}) }}</div>
                    <h2 class="card-title">{{ item.title }}</h2>
                    <p class="text-secondary">{{ item.text }}</p>
                    <a href="{{ path(item.route) }}" class="btn btn-outline-primary">Open {{ item.title|lower }}</a>
                </div></div>
            </div>
        {% endfor %}
    </div>
{% endblock %}
