{% extends 'base.html.twig' %}
{% block title %}My inventory{% endblock %}
{% block body %}
    <h1>My inventory</h1>
    <p class="text-muted">Your private inventory. Right-click an item to add, rename, or delete it. Drag items to move them.</p>
    <twig:api_tree
        stimulusController="inventory_tree"
        apiUrl="/api/locations"
        :filter="{building: building.id}"
        :editable="true"
        :openAll="true"
        :selectedId="building.rootLocation.id ~ ''"
        :caller="_self"
    >
        <twig:block name="api_tree_content">
            <h3>{{ item.name ?? node.name }}</h3>
            <p>Right-click in the tree to manage this item.</p>
        </twig:block>
    </twig:api_tree>
{% endblock %}
