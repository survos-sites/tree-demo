{% extends 'base.html.twig' %}

{% block title %}Sign in · Tree & Table{% endblock %}

{% block body %}
    <div class="container-tight py-4">
        <form method="post" class="card card-md">
            <div class="card-body">
                <h1 class="h2 text-center mb-4">Sign in</h1>
                {% if error %}
                    <div class="alert alert-danger" role="alert">{{ error.messageKey|trans(error.messageData, 'security') }}</div>
                {% endif %}
                {% if app.user %}
                    <p>You are signed in as {{ app.user.userIdentifier }}. <a href="{{ path('app_logout') }}">Sign out</a></p>
                {% endif %}
                <div class="mb-3">
                    <label for="inputEmail" class="form-label">Email</label>
                    <input type="email" value="{{ last_username }}" name="email" id="inputEmail" class="form-control" autocomplete="username" required autofocus>
                </div>
                <div class="mb-3">
                    <label for="inputPassword" class="form-label">Password</label>
                    <input type="password" name="password" id="inputPassword" class="form-control" autocomplete="current-password" required>
                </div>
                <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">
                <div class="form-footer">
                    <button class="btn btn-primary w-100" type="submit">Sign in</button>
                </div>
            </div>
        </form>
    </div>
{% endblock %}
